# 이 파일을 복사해 .env 로 만들고 실제 키를 채우세요:  cp .env.example .env
# ⚠️ .env 는 절대 커밋하지 마세요. (.gitignore 가 제외합니다)
# ⚠️ API 키는 오직 이 서버(백엔드)에서만 사용합니다. 브라우저/리포지토리에 두지 마세요.

# Anthropic API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_KEY

# 프록시 포트 (기본 8787)
PORT=8787
